<Window x:Class="ShopDesk.productsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShopDesk - главное" Height="650" Width="950"
        Background="LightGray">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Заголовок -->
        <TextBlock Grid.Row="0" Text="🛒 ShopDesk" FontSize="28" Margin="0,0,0,10"/>

        <!-- 1. Кнопки действий -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Завершить сессию🚶" Height="30" Width="150"
                    Background="Red" Click="Logout_Click"/>
            <Button Content="Добавить➕"  Height="30" Width="100" Background="GreenYellow"
                    Click="Add_Click"    Margin="10,0,0,0"/>
            <Button Content="Изменить📝" Height="30" Width="100" Background="Yellow"
                    Click="Edit_Click"   Margin="10,0,0,0"/>
            <Button Content="Удалить🗑️"  Height="30" Width="100" Background="Red"
                    Click="Delete_Click" Margin="10,0,0,0"/>
            <Button Content="Сохранить💾" Height="30" Width="110" Background="Blue"
                    Foreground="White" Click="Save_Click" Margin="10,0,0,0"/>
            <Button Content="Обновить🔄"  Height="30" Width="110" Background="LightBlue"
                    Click="Refresh_Click" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 2. Встроенная панель редактора (скрыта по умолчанию) -->
        <Border Grid.Row="2"
                x:Name="EditorPanel"
                Visibility="Collapsed"
                BorderBrush="Gray" BorderThickness="1"
                Background="WhiteSmoke" Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="EditorTitle"
                           Text="Редактор"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FieldsPanel"/>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="OK" Width="80"
                            Click="EditorOk_Click" IsDefault="True"/>
                    <Button Content="Отмена" Width="80"
                            Click="EditorCancel_Click" IsCancel="True"
                            Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. Вкладки с таблицами -->
        <TabControl Grid.Row="3"
                    x:Name="MainTabs"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Товары">
                <DataGrid x:Name="ProductsGrid"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="Категории">
                <DataGrid x:Name="CategoryGrid"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="Поставщики">
                <DataGrid x:Name="SuppliersGrid"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True"/>
            </TabItem>
        </TabControl>

        <!-- 4. Экспорт -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Экспорт в CSV" Height="30" Width="130"
                    Background="Aqua" Click="ExportCsv_Click"/>
            <Button Content="Экспорт в Excel" Height="30" Width="140"
                    Background="LightGreen" Click="ExportExcel_Click"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>