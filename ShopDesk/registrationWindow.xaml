<Window x:Class="ShopDesk.registrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopDesk"
        mc:Ignorable="d"
        Title="ShopDesk - регистрация" Height="450" Width="800" Background="LightGray">
    <Grid>
        <StackPanel>
            <TextBlock Text="📝Регистрация" FontSize="40" Width="300" Margin="0,40,0,0"/>
            <TextBlock Text="ФИО:" FontSize="24" Width="60" Margin="0,30,550,0"/>
            <TextBox x:Name="nametxt" Height="30" Width="500" Margin="200,-30,0,0"/>
            <TextBlock Text="Должность:" FontSize="24" Width="130" Margin="0,30,550,0"/>
            <TextBox x:Name="posttxt" Height="30" Width="500" Margin="200,-30,0,0"/>
            <TextBlock Text="Логин:" FontSize="24" Width="75" Margin="0,30,550,0"/>
            <TextBox x:Name="logintxt" Height="30" Width="500" Margin="200,-30,0,0"/>
            <TextBlock Text="Пароль:" FontSize="24" Width="90" Margin="0,30,550,0"/>
            <TextBox x:Name="passwordtxt" Height="30" Width="500" Margin="200,-30,0,0"/>
            <Button x:Name="registrationbtn" Content="Зарегестрироваться" FontSize="15" Height="30" Width="200" Margin="0,20,0,0" Background="LightGreen" Click="registrationbtn_Click"/>
        </StackPanel>
        
    </Grid>
</Window>
