<Window x:Class="ShopDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopDesk"
        mc:Ignorable="d"
        Title="ShopDesk - авторизация" Height="450" Width="800" Background="LightGray">
    <Grid>
        <StackPanel>
            <TextBlock Text="🚪Авторизация" FontSize="40" Width="300" Margin="0,70,0,0"/>
            <TextBlock Text="Для начала работы необходимо авторизироваться" Width="355" FontSize="15"/>
            <TextBox x:Name="txtlogin" Width="600" Height="30" Margin="0,20,0,0"/>
            <TextBox x:Name="txtpassword" Width="600" Height="30" Margin="0,20,0,0"/>
            <Button Content="Войти🚶" x:Name="loginbtn"  FontSize="15" Height="30" Width="200" Background="LightGreen" Margin="0,20,0,0" Click="loginbtn_Click"/>
            <Button Content="Зарегистрироваться📝" x:Name="btnregistration" FontSize="15" Height="30" Width="200" Background="Cyan" Margin="0,20,0,0" Click="btnregistration_Click"/>
        </StackPanel>
    </Grid>
</Window>
